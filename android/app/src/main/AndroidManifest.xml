<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ===================== PERMISSIONS ===================== -->
    <!-- Receive and read incoming SMS -->
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.READ_SMS" />

    <!-- Send email over SMTP -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Android 13+ notification permission (for the foreground-service notification) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Foreground service to keep the process alive on aggressive OEMs -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Android 14+ requires a typed foreground-service permission.
         "dataSync" is the pragmatic type for a personal sideloaded app. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- Restart the service automatically after reboot -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Keep CPU/Wi-Fi awake while forwarding; ask to ignore battery optimizations -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:label="SMS to Gmail"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

        <!-- ===================== SMS RECEIVER =====================
             `another_telephony` ships its own IncomingSmsReceiver and merges it
             into the manifest automatically. We declare an explicit intent-filter
             copy here (with high priority) so reception is robust across OEMs.
             If you ever hit a "duplicate receiver" manifest-merge error, delete
             this <receiver> block — the plugin's own one is enough. -->
        <receiver
            android:name="com.shounakmulay.telephony.sms.IncomingSmsReceiver"
            android:permission="android.permission.BROADCAST_SMS"
            android:exported="true"
            tools:node="merge">
            <intent-filter android:priority="999">
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>

        <!-- ===================== FOREGROUND SERVICE =====================
             Override the foreground-service type declared by flutter_foreground_task
             so it matches the Android 14+ permission we requested above. -->
        <service
            android:name="com.pravera.flutter_foreground_task.service.ForegroundService"
            android:foregroundServiceType="dataSync"
            android:exported="false"
            tools:replace="android:foregroundServiceType" />

        <!-- ===================== BOOT RECEIVER =====================
             flutter_foreground_task provides a BootReceiver that restarts the
             service after reboot when `autoRunOnBoot: true` (set in main.dart).
             We add the BOOT_COMPLETED intent-filter so it fires. -->
        <receiver
            android:name="com.pravera.flutter_foreground_task.service.RebootReceiver"
            android:exported="true"
            tools:replace="android:exported"
            tools:node="merge">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

    </application>

    <!-- Needed so permission_handler / url launching can resolve settings intents -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
        </intent>
    </queries>
</manifest>
